{
  "name": "campussphere-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:campus": "pnpm --filter @cs/campus dev",
    "dev:sphera": "pnpm --filter @cs/sphera dev",
    "dev:backend": "pnpm --filter @cs/backend dev",
    "build": "turbo build",
    "build:campus": "pnpm --filter @cs/campus build",
    "build:sphera": "pnpm --filter @cs/sphera build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.26",
      "@types/react-dom": "^18.3.7"
    }
  }
}
