# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Variable names deliberately match the Django deployment's, so the existing Render
# dashboard configuration carries over unchanged. DIRECT_URL is the only addition.

# ── Database ────────────────────────────────────────────────────────────────
# Supabase: take BOTH strings from Project Settings -> Database -> Connection string
# -> "Connection pooling". Do NOT use the direct `db.<ref>.supabase.co` host — it is
# IPv6-only and unreachable from networks without IPv6 egress.
#
#   DATABASE_URL -> Transaction mode, port 6543, with ?pgbouncer=true
#   DIRECT_URL   -> Session mode,     port 5432, no pgbouncer flag
#
# `connection_limit` sizes Prisma's own pool, and Supabase's documented value of 1
# is advice for serverless functions, where each invocation is a separate process.
# This runs as a long-lived container serving concurrent requests, so a limit of 1
# serialises every query behind a single connection. Leave it unset to get Prisma's
# default, or set it deliberately against the pooler's client budget.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Core ────────────────────────────────────────────────────────────────────
SECRET_KEY="change-me-in-production"
DEBUG="true"
PORT="3000"

ALLOWED_HOSTS="localhost,127.0.0.1"
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:8080"
FRONTEND_URL="http://localhost:8080"

# ── Supabase Auth (token exchange) ──────────────────────────────────────────
SUPABASE_URL=""
SUPABASE_JWT_SECRET=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── AI providers (Sphera routing & fallback chain) ──────────────────────────
# AWS credentials (IAM SigV4 for Amazon Bedrock Mantle & S3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
# Optional overrides for Bedrock IAM credentials if distinct from storage:
# BEDROCK_AWS_ACCESS_KEY_ID=""
# BEDROCK_AWS_SECRET_ACCESS_KEY=""
# BEDROCK_AWS_REGION="us-east-1"

# ── Amazon Bedrock Mantle ──
BEDROCK_MANTLE_ENDPOINT="https://bedrock-mantle.us-east-1.api.aws/v1"
BEDROCK_MANTLE_REGION="us-east-1"
BEDROCK_MANTLE_DEEPSEEK_MODEL_ID="deepseek.v3.2"
BEDROCK_MANTLE_MINIMAX_MODEL_ID="minimax.minimax-m2.5"
BEDROCK_MANTLE_CLAUDE_MODEL_ID="anthropic.claude-haiku-4-5"

# Primary model for structured tasks (fiches, quiz, flashcards): "deepseek" or "minimax"
BEDROCK_MANTLE_PRIMARY_STRUCTURED="deepseek"

# Configurable Mantle rates (USD per 1M tokens)
BEDROCK_MANTLE_DEEPSEEK_INPUT_PRICE="0.62"
BEDROCK_MANTLE_DEEPSEEK_OUTPUT_PRICE="1.85"
BEDROCK_MANTLE_MINIMAX_INPUT_PRICE="0.30"
BEDROCK_MANTLE_MINIMAX_OUTPUT_PRICE="1.20"
BEDROCK_MANTLE_CLAUDE_INPUT_PRICE="1.00"
BEDROCK_MANTLE_CLAUDE_OUTPUT_PRICE="5.00"

# Bedrock Budget & Safety threshold
BEDROCK_TOTAL_BUDGET_USD="90"
BEDROCK_SAFETY_THRESHOLD_PERCENT="90"

# Fallback & Suggestions providers:
GEMINI_API_KEY=""
GROQ_API_KEY=""


# ── Object storage ──────────────────────────────────────────────────────────
# Must be true in production: the server refuses to boot otherwise, because
# Render's plan has no persistent disk and local uploads are destroyed on redeploy.
USE_S3="false"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_STORAGE_BUCKET_NAME=""
AWS_S3_REGION_NAME="us-east-1"

# ── Scale-out ───────────────────────────────────────────────────────────────
# Optional in development, REQUIRED in production (the server refuses to boot
# without it). Redis carries everything that must be shared between instances:
# WebSocket fan-out, rate-limit counters and scheduled-job leadership. Leave it
# empty locally and each subsystem falls back to a process-local implementation,
# which is correct for exactly one instance and silently wrong for more.
#   local:   redis://127.0.0.1:6379
#   Render:  the *internal* URL of a Key Value instance (redis://red-…:6379),
#            which requires the instance to be in the same region as the service
#   Upstash: rediss://… — ioredis enables TLS from the scheme, no config needed
REDIS_URL=""

# Escape hatch for a genuinely single-instance deployment. Setting this to true
# lets production boot without REDIS_URL, accepting process-local fan-out, rate
# limits and job scheduling. Correct for exactly one instance; silently wrong the
# moment a second one starts, so unset it before raising the instance count.
SINGLE_INSTANCE=""

# ── Optional ────────────────────────────────────────────────────────────────
# SMTP. Delivery stays off unless both are set — Django shipped placeholder
# defaults, so no mail has ever been sent from this app.
EMAIL_HOST_USER=""
EMAIL_HOST_PASSWORD=""

# Development/test only: turns off rate limiting so the contract suite can fire
# hundreds of requests from one address. Refused in production.
DISABLE_RATE_LIMITS=""
