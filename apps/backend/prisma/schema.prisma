// CampusSphere — Prisma schema for the Node/Express backend.
//
// Clean redesign, not a mirror of the Django schema: no `django_content_type`,
// no `auth_permission`, no `users_user` naming, no Django migration ledger.
// Shapes are pinned by documentation/API_CONTRACT.md; route status by
// documentation/API_INVENTORY.md.
//
// Integer primary keys are deliberate — every client route matches `<int:pk>` and
// serialises ids as numbers, so switching to UUID would break the API contract.
// UploadedFile keeps a UUID because its route is `<uuid:pk>`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Pooled connection (Supavisor transaction mode, port 6543) for the application.
  url = env("DATABASE_URL")

  // Unpooled connection for migrations and introspection, which need session state
  // that a transaction-mode pooler cannot provide.
  //
  // On Supabase this must be the pooler's SESSION mode (port 5432), not the direct
  // `db.<ref>.supabase.co` host: that host resolves to IPv6 only, so it is
  // unreachable from any network without IPv6 egress.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum ProfileVisibility {
  PUBLIC
  CONNECTIONS
  PRIVATE
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum SphereCategory {
  ACADEMIC
  PROFESSIONAL
  SOCIAL
  SPORTS
  ARTS
  TECHNOLOGY
  OTHER
}

enum SphereType {
  COURS
  PROJET
  CLUB
  REVISION
  COMMUNAUTE
}

enum SphereRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum SphereMemberStatus {
  ACTIVE
  PENDING
  INACTIVE
  BANNED
}

/// Post visibility. `SPHERE` requires `Post.sphereId`.
enum PostVisibility {
  PUBLIC
  SPHERE
  FRIENDS
}

enum PostCategory {
  GENERAL
  ACADEMIC
  EVENT
  MARKETPLACE
  HELP
  ANNOUNCEMENT
}

enum PostType {
  TEXT
  COURS
  TD_TP
  EXAM
  PROJECT
  RESOURCE
  OTHER
}

/// Resource visibility. Deliberately distinct from PostVisibility: a resource can
/// be university-scoped, a post cannot; a post can be sphere-scoped, a resource
/// cannot. Legacy `private` maps to FRIENDS on write.
enum ResourceVisibility {
  PUBLIC
  UNIVERSITY
  FRIENDS
}

enum ResourceType {
  COURSE_NOTES
  TD_TP
  EXAMS
  PROJECT
  BOOK
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

enum ShareChannel {
  COPY_LINK
  UNKNOWN
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum KanbanStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum ConversationType {
  PRIVATE
  GROUP
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  FILE
  SYSTEM
}

enum MessageStatus {
  SENDING
  SENT
  DELIVERED
  READ
}

enum ConversationMemberRole {
  OWNER
  ADMIN
  MEMBER
}

/// Canonical set of 15. Reconciles three divergent lists — see API_CONTRACT §2.
/// Django emitted `message_received` (declared nowhere) where both enums said
/// `message`, and `verification_status` was emitted but never declared.
enum NotificationType {
  POST_LIKE
  POST_COMMENT
  COMMENT_REPLY
  MENTION_POST
  MENTION_COMMENT
  SPHERE_INVITATION
  SPHERE_JOIN_REQUEST
  TASK_ASSIGNED
  TASK_COMPLETED
  RESOURCE_SHARED
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  MESSAGE
  SYSTEM
  VERIFICATION_STATUS
  NEW_EVENT
  EVENT_REMINDER
}

enum EventCategory {
  CONFERENCE
  HACKATHON
  PARTY
  COMPETITION
  WORKSHOP
  OTHER
}

enum EventAttendeeStatus {
  INTERESTED
  GOING
  ATTENDED
}

enum StudyToolType {
  FICHE
  QUIZ
  FLASHCARDS
  MINDMAP
  AUDIO
}

enum AnnaleMode {
  COMPLETE
  RAPIDE
}

enum UploadType {
  AVATAR
  COVER
  POST
  RESOURCE
  OTHER
}

// ─────────────────────────────────────────────────────────────
// Users
// ─────────────────────────────────────────────────────────────

model User {
  id        Int    @id @default(autoincrement())
  email     String @unique
  username  String @unique
  firstName String @map("first_name")
  lastName  String @map("last_name")

  /// argon2id. Null for Supabase-only accounts, which never had a local password.
  /// Django's PBKDF2 hashes are not carried over — no accounts are being preserved.
  passwordHash String? @map("password_hash")
  supabaseUid  String? @unique @map("supabase_uid")

  university String @default("")
  faculty    String @default("")
  studyYear  String @default("") @map("study_year")
  studentId  String @default("") @map("student_id")
  campus     String @default("")
  town       String @default("")

  bio         String    @default("")
  avatar      String?
  coverPhoto  String?   @map("cover_photo")
  phoneNumber String    @default("") @map("phone_number")
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  language    Json      @default("[]")

  profileVisibility ProfileVisibility @default(PUBLIC) @map("profile_visibility")
  postVisibility    ProfileVisibility @default(PUBLIC) @map("post_visibility")

  impactScore Int    @default(0) @map("impact_score")
  currentMood String @default("excited") @map("current_mood")

  skills            Json @default("[]")
  interests         Json @default("[]")
  previousEducation Json @default("[]") @map("previous_education")
  experiences       Json @default("[]")
  portfolioLinks    Json @default("[]") @map("portfolio_links")

  // NOTE: `is_profile_complete` is deliberately NOT a column. Django stored it and
  // then recomputed it from an empty required-field list, so `all([]) == True`
  // force-wrote it True on every login and permanently defeated onboarding.
  // It is now derived: university != '' AND faculty != '' AND studyYear != ''.

  isVerified Boolean @default(false) @map("is_verified")
  cardImage  String? @map("card_image")

  isActive    Boolean  @default(true) @map("is_active")
  isStaff     Boolean  @default(false) @map("is_staff")
  isSuperuser Boolean  @default(false) @map("is_superuser")
  dateJoined  DateTime @default(now()) @map("date_joined")
  updatedAt   DateTime @updatedAt @map("updated_at")

  dataExportRequestedAt DateTime? @map("data_export_requested_at")

  sentConnections     Connection[]              @relation("ConnectionRequester")
  receivedConnections Connection[]              @relation("ConnectionRecipient")
  initiatedBlocks     UserBlock[]               @relation("Blocker")
  receivedBlocks      UserBlock[]               @relation("Blocked")
  posts               Post[]
  postLikes           PostLike[]
  postSaves           PostSave[]
  postImpactRatings   PostImpactRating[]
  postReports         PostReport[]
  comments            Comment[]
  commentLikes        CommentLike[]
  spheresCreated      Sphere[]
  sphereMemberships   SphereMember[]
  sphereFiles         SphereFile[]
  resources           Resource[]
  resourceFolders     ResourceFolder[]
  resourceSaves       ResourceSave[]
  resourceViews       ResourceView[]
  resourceReports     ResourceReport[]
  resourceShareEvents ResourceShareEvent[]
  tasksCreated        Task[]                    @relation("TaskCreator")
  tasksAssigned       Task[]                    @relation("TaskAssignee")
  conversations       ConversationMember[]
  conversationsOwned  Conversation[]            @relation("ConversationCreator")
  messages            Message[]
  messageReads        MessageRead[]
  messageReactions    MessageReaction[]
  readReceipts        ConversationReadReceipt[]
  notifications       Notification[]
  notificationSetting NotificationSettings?
  studySessions       StudySession[]
  annaleSessions      AnnaleSession[]
  artefacts           Artefact[]
  chatThreads         ChatThread[]
  eventsOrganized     Event[]                   @relation("EventsOrganized")
  eventAttendances    EventAttendee[]           @relation("UserEventAttendances")
  eventCheckins       EventAttendee[]           @relation("EventCheckins")
  uploads             UploadedFile[]
  auditLogs           AdminAuditLog[]
  revokedTokens       RevokedToken[]
  quizLiveHosted      QuizLiveSession[]       @relation("QuizLiveSessionsHosted")
  quizLiveParticipations QuizLiveParticipant[] @relation("QuizLiveParticipations")
  generationUsages    GenerationUsage[]
  aiUsageLogs         AIUsageLog[]
  spheraPreferences   SpheraPreferences?

  @@index([university])
  @@index([faculty])
  @@map("users")
}

model Connection {
  id          Int              @id @default(autoincrement())
  requesterId Int              @map("requester_id")
  recipientId Int              @map("recipient_id")
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  requester User @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("ConnectionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([requesterId, recipientId])
  @@index([recipientId, status])
  @@map("connections")
}

model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int      @map("blocker_id")
  blockedId Int      @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("user_blocks")
}

/// Replaces SimpleJWT's blacklist. Django configured BLACKLIST_AFTER_ROTATION but
/// never installed the app, so logout's blacklist call silently no-opped inside a
/// bare `except` — refresh tokens were never actually revocable.
model RevokedToken {
  id        Int      @id @default(autoincrement())
  jti       String   @unique
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime @default(now()) @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("revoked_tokens")
}

model ContactMessage {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  subject    String
  message    String
  newsletter Boolean  @default(false)
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model AdminAuditLog {
  id          Int      @id @default(autoincrement())
  actorId     Int?     @map("actor_id")
  action      String
  targetType  String   @map("target_type")
  targetId    String   @default("") @map("target_id")
  payloadDiff Json     @default("{}") @map("payload_diff")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
  @@index([targetType])
  @@map("admin_audit_logs")
}

// ─────────────────────────────────────────────────────────────
// Spheres
// ─────────────────────────────────────────────────────────────

model Sphere {
  id          Int            @id @default(autoincrement())
  name        String
  description String
  category    SphereCategory
  sphereType  SphereType     @default(COMMUNAUTE) @map("sphere_type")
  color       String         @default("#10b981")
  icon        String         @default("users")
  bannerImage String?        @map("banner_image")

  isPrivate       Boolean @default(false) @map("is_private")
  requireApproval Boolean @default(false) @map("require_approval")

  objective          String    @default("")
  targetAudience     String    @default("") @map("target_audience")
  duration           String    @default("permanent")
  expiresAt          DateTime? @map("expires_at")
  autoDeleteOnExpiry Boolean   @default(false) @map("auto_delete_on_expiry")
  collaborationTypes Json      @default("[]") @map("collaboration_types")

  /// Denormalised count of ACTIVE members. Must be recomputed on every membership
  /// mutation, as Django's update_member_count did.
  memberCount Int @default(0) @map("member_count")
  impactScore Int @default(0) @map("impact_score")

  createdById Int      @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  members        SphereMember[]
  files          SphereFile[]
  posts          Post[]
  tasks          Task[]
  studySessions  StudySession[]
  annaleSessions AnnaleSession[]
  events         Event[]         @relation("SphereEvents")

  @@index([isPrivate, expiresAt])
  @@map("spheres")
}

model SphereMember {
  id       Int                @id @default(autoincrement())
  sphereId Int                @map("sphere_id")
  userId   Int                @map("user_id")
  role     SphereRole         @default(MEMBER)
  status   SphereMemberStatus @default(ACTIVE)
  joinedAt DateTime           @default(now()) @map("joined_at")

  sphere Sphere @relation(fields: [sphereId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sphereId, userId])
  @@index([userId, status])
  @@index([sphereId, status])
  @@map("sphere_members")
}

/// Sphere-scoped attachment. Deliberately distinct from Resource: no folders, no
/// visibility rules, no impact scoring — access is membership of the sphere.
/// Conflating the two is what produced the ID-space collision in SphereSpheraTab.
model SphereFile {
  id           Int      @id @default(autoincrement())
  sphereId     Int      @map("sphere_id")
  uploadedById Int      @map("uploaded_by_id")
  title        String
  fileUrl      String   @map("file_url")
  storageKey   String?  @map("storage_key")
  fileSize     Int      @default(0) @map("file_size")
  fileType     String   @default("") @map("file_type")
  createdAt    DateTime @default(now()) @map("created_at")

  sphere        Sphere         @relation(fields: [sphereId], references: [id], onDelete: Cascade)
  uploadedBy    User           @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  studySessions StudySession[]

  @@index([sphereId])
  @@map("sphere_files")
}

// ─────────────────────────────────────────────────────────────
// Posts
// ─────────────────────────────────────────────────────────────

model Post {
  id       Int    @id @default(autoincrement())
  content  String
  authorId Int    @map("author_id")
  sphereId Int?   @map("sphere_id")

  category      PostCategory   @default(GENERAL)
  visibility    PostVisibility @default(PUBLIC)
  subject       String         @default("")
  type          PostType       @default(TEXT)
  audience      String         @default("")
  location      String         @default("")
  tags          Json           @default("[]")
  files         Json           @default("[]")
  allowComments Boolean        @default(true) @map("allow_comments")
  isPinned      Boolean        @default(false) @map("is_pinned")

  likesCount    Int @default(0) @map("likes_count")
  commentsCount Int @default(0) @map("comments_count")
  /// Sum of all PostImpactRating.value for this post.
  impactScore   Int @default(0) @map("impact_score")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author        User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  sphere        Sphere?            @relation(fields: [sphereId], references: [id], onDelete: Cascade)
  likes         PostLike[]
  saves         PostSave[]
  impactRatings PostImpactRating[]
  comments      Comment[]
  reports       PostReport[]

  @@index([visibility, createdAt])
  @@index([authorId])
  @@index([sphereId])
  @@map("posts")
}

model PostLike {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model PostSave {
  id      Int      @id @default(autoincrement())
  postId  Int      @map("post_id")
  userId  Int      @map("user_id")
  savedAt DateTime @default(now()) @map("saved_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_saves")
}

model PostImpactRating {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  userId    Int      @map("user_id")
  /// 1–5, enforced at the API layer.
  value     Int
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_impact_ratings")
}

model Comment {
  id         Int      @id @default(autoincrement())
  content    String
  postId     Int      @map("post_id")
  authorId   Int      @map("author_id")
  parentId   Int?     @map("parent_id")
  likesCount Int      @default(0) @map("likes_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("CommentReplies")
  likes   CommentLike[]

  @@index([postId, parentId])
  @@map("comments")
}

model CommentLike {
  id        Int      @id @default(autoincrement())
  commentId Int      @map("comment_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_likes")
}

model PostReport {
  id         Int          @id @default(autoincrement())
  postId     Int          @map("post_id")
  reporterId Int          @map("reporter_id")
  reason     String
  details    String       @default("")
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([postId, reporterId])
  @@index([status])
  @@map("post_reports")
}

// ─────────────────────────────────────────────────────────────
// Resources
// ─────────────────────────────────────────────────────────────

model ResourceFolder {
  id          Int                @id @default(autoincrement())
  ownerId     Int                @map("owner_id")
  name        String
  description String             @default("")
  visibility  ResourceVisibility @default(PUBLIC)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  owner     User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  resources Resource[]

  // Max 4 folders per owner and 20 resources per folder are API-layer rules.
  @@unique([ownerId, name])
  @@map("resource_folders")
}

/// A user's personal library item. NOT sphere-scoped — Django's serializer accepted
/// a `sphere` key and assigned it to a column that never existed, producing a 500 on
/// write and a permanently-null `sphere_id` on read. Sphere attachments are SphereFile.
model Resource {
  id          Int    @id @default(autoincrement())
  title       String
  description String @default("")
  authorId    Int    @map("author_id")

  fileUrl    String  @map("file_url")
  /// Storage-driver key. The URL is derived from it and may change if the CDN or
  /// bucket does; the key is the stable identifier used for fetch and delete.
  storageKey String? @map("storage_key")
  fileSize   Int     @map("file_size")
  fileType   String  @map("file_type")

  subject    String             @default("other")
  type       ResourceType
  visibility ResourceVisibility @default(PUBLIC)
  audience   String             @default("")
  tags       Json               @default("[]")
  folderId   Int?               @map("folder_id")

  impactScore    Int @default(0) @map("impact_score")
  downloadsCount Int @default(0) @map("downloads_count")
  viewsCount     Int @default(0) @map("views_count")
  savesCount     Int @default(0) @map("saves_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author         User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  folder         ResourceFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  saves          ResourceSave[]
  views          ResourceView[]
  reports        ResourceReport[]
  shareEvents    ResourceShareEvent[]
  studySessions  StudySession[]
  annalesAsPaper AnnaleSession[]      @relation("AnnalePaper")
  annalesAsCours AnnaleSession[]      @relation("AnnaleCours")

  @@index([visibility, createdAt])
  @@index([authorId])
  @@map("resources")
}

model ResourceSave {
  id         Int      @id @default(autoincrement())
  resourceId Int      @map("resource_id")
  userId     Int      @map("user_id")
  savedAt    DateTime @default(now()) @map("saved_at")

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, userId])
  @@map("resource_saves")
}

model ResourceView {
  id         Int      @id @default(autoincrement())
  resourceId Int      @map("resource_id")
  userId     Int      @map("user_id")
  viewedAt   DateTime @default(now()) @map("viewed_at")

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, userId])
  @@map("resource_views")
}

model ResourceReport {
  id         Int          @id @default(autoincrement())
  resourceId Int          @map("resource_id")
  reporterId Int          @map("reporter_id")
  reason     String
  details    String       @default("")
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  reporter User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([resourceId, reporterId])
  @@index([status])
  @@map("resource_reports")
}

model ResourceShareEvent {
  id         Int          @id @default(autoincrement())
  resourceId Int          @map("resource_id")
  userId     Int?         @map("user_id")
  channel    ShareChannel @default(COPY_LINK)
  createdAt  DateTime     @default(now()) @map("created_at")

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("resource_share_events")
}

// ─────────────────────────────────────────────────────────────
// Tasks
// ─────────────────────────────────────────────────────────────

model Task {
  id           Int          @id @default(autoincrement())
  title        String
  description  String       @default("")
  assignedToId Int?         @map("assigned_to_id")
  priority     TaskPriority @default(MEDIUM)
  dueDate      DateTime?    @map("due_date")
  isCompleted  Boolean      @default(false) @map("is_completed")
  kanbanStatus KanbanStatus @default(TODO) @map("kanban_status")
  impactPoints Int          @default(5) @map("impact_points")

  sphereId    Int      @map("sphere_id")
  createdById Int      @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // NOTE: assignment takes an integer user id. Django's TaskAssignSerializer
  // declared `assigned_to_id` as a UUIDField against a 64-bit integer PK, so the
  // route rejected every valid id. Unnoticed because no client calls it.
  assignedTo User?  @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  sphere     Sphere @relation(fields: [sphereId], references: [id], onDelete: Cascade)
  createdBy  User   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([sphereId, kanbanStatus])
  @@index([assignedToId])
  @@map("tasks")
}

// ─────────────────────────────────────────────────────────────
// Messaging
// ─────────────────────────────────────────────────────────────

model Conversation {
  id          Int              @id @default(autoincrement())
  type        ConversationType @default(PRIVATE)
  name        String           @default("")
  avatarUrl   String?          @map("avatar_url")
  createdById Int?             @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  createdBy    User?                     @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants ConversationMember[]
  messages     Message[]
  readReceipts ConversationReadReceipt[]

  @@index([updatedAt])
  @@map("conversations")
}

/// Explicit join table rather than an implicit M2M, so membership can be queried
/// and indexed directly.
model ConversationMember {
  conversationId Int                    @map("conversation_id")
  userId         Int                    @map("user_id")
  role           ConversationMemberRole @default(MEMBER)
  joinedAt       DateTime               @default(now()) @map("joined_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             Int           @id @default(autoincrement())
  type           MessageType   @default(TEXT)
  status         MessageStatus @default(SENT)
  content        String
  conversationId Int           @map("conversation_id")
  authorId       Int           @map("author_id")

  // Media attachments
  mediaUrl       String?       @map("media_url")
  mediaType      String?       @map("media_type")
  fileName       String?       @map("file_name")
  fileSize       Int?          @map("file_size")
  duration       Float?        @map("duration")

  // Replies / Quotes
  replyToId      Int?          @map("reply_to_id")
  replyTo        Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]     @relation("MessageReplies")

  // Soft delete
  isDeleted      Boolean       @default(false) @map("is_deleted")
  deletedAt      DateTime?     @map("deleted_at")

  // Edit tracking
  isEdited       Boolean       @default(false) @map("is_edited")

  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  readBy         MessageRead[]
  reactions      MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([replyToId])
  @@map("messages")
}

model MessageReaction {
  id        Int      @id @default(autoincrement())
  messageId Int      @map("message_id")
  userId    Int      @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@map("message_reactions")
}

model MessageRead {
  messageId Int      @map("message_id")
  userId    Int      @map("user_id")
  readAt    DateTime @default(now()) @map("read_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@map("message_reads")
}

model ConversationReadReceipt {
  id             Int      @id @default(autoincrement())
  conversationId Int      @map("conversation_id")
  userId         Int      @map("user_id")
  lastReadAt     DateTime @default(now()) @map("last_read_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_read_receipts")
}

// ─────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────

model Notification {
  id          Int              @id @default(autoincrement())
  type        NotificationType
  title       String
  message     String
  recipientId Int              @map("recipient_id")
  data        Json             @default("{}")
  isRead      Boolean          @default(false) @map("is_read")
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead, createdAt])
  @@map("notifications")
}

model NotificationSettings {
  id     Int @id @default(autoincrement())
  userId Int @unique @map("user_id")

  emailPostLikes         Boolean @default(true) @map("email_post_likes")
  emailPostComments      Boolean @default(true) @map("email_post_comments")
  emailSphereInvitations Boolean @default(true) @map("email_sphere_invitations")
  emailTaskAssignments   Boolean @default(true) @map("email_task_assignments")
  emailMessages          Boolean @default(true) @map("email_messages")

  pushPostLikes         Boolean @default(false) @map("push_post_likes")
  pushPostComments      Boolean @default(true) @map("push_post_comments")
  pushSphereInvitations Boolean @default(true) @map("push_sphere_invitations")
  pushTaskAssignments   Boolean @default(true) @map("push_task_assignments")
  pushMessages          Boolean @default(true) @map("push_messages")

  inAppPostLikes         Boolean @default(true) @map("in_app_post_likes")
  inAppPostComments      Boolean @default(true) @map("in_app_post_comments")
  inAppSphereInvitations Boolean @default(true) @map("in_app_sphere_invitations")
  inAppTaskAssignments   Boolean @default(true) @map("in_app_task_assignments")
  inAppMessages          Boolean @default(true) @map("in_app_messages")

  systemUpdates   Boolean @default(true) @map("system_updates")
  marketingEmails Boolean @default(false) @map("marketing_emails")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

// ─────────────────────────────────────────────────────────────
// Sphera (AI)
// ─────────────────────────────────────────────────────────────

model StudySession {
  id      Int @id @default(autoincrement())
  ownerId Int @map("owner_id")

  // Exactly one source. Enforced at the API layer: supplying both, or neither, is
  // a 400. Django only accepted `resource_id`, so SphereSpheraTab passed a
  // SphereFile id into the Resource ID space — different sequences, so it 404'd or
  // silently generated from an unrelated document.
  resourceId     Int?   @map("resource_id")
  sphereFileId   Int?   @map("sphere_file_id")
  sourceFilename String @default("") @map("source_filename")

  toolTypes StudyToolType[] @map("tool_types")
  content   Json            @default("{}")

  /// Source text for Q&A and for add-tool regeneration. Never serialised.
  extractedText String @default("") @map("extracted_text")
  pageCount     Int    @default(1) @map("page_count")
  ficheContent  Json?  @map("fiche_content")
  qaHistory     Json   @default("[]") @map("qa_history")
  suggestions   Json   @default("[]")

  isShared       Boolean @default(false) @map("is_shared")
  sharedSphereId Int?    @map("shared_sphere_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  resource     Resource?    @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  sphereFile   SphereFile?  @relation(fields: [sphereFileId], references: [id], onDelete: SetNull)
  sharedSphere Sphere?      @relation(fields: [sharedSphereId], references: [id], onDelete: SetNull)
  artefacts    Artefact[]
  chatThreads  ChatThread[]

  @@index([ownerId, createdAt])
  @@index([sharedSphereId, isShared])
  @@map("study_sessions")
}

model Artefact {
  id             Int          @id @default(autoincrement())
  sessionId      Int          @map("session_id")
  ownerId        Int          @map("owner_id")

  // Type d'artefact : 'quiz', 'flashcards', 'mindmap', 'audio', 'note'
  type           String       @map("type")
  title          String       @default("")
  subtitle       String?
  content        Json         @default("{}")

  targetChapter  String?      @map("target_chapter")
  fromSelection  Boolean      @default(false) @map("from_selection")
  selectionText  String?      @map("selection_text") @db.Text

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  session        StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([ownerId, createdAt])
  @@map("artefacts")
}

model ChatThread {
  id             Int           @id @default(autoincrement())
  sessionId      Int           @map("session_id")
  ownerId        Int           @map("owner_id")
  title          String        @default("Discussion générale")
  messages       ChatMessage[]

  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  session        StudySession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([ownerId])
  @@map("sphera_chat_threads")
}

model ChatMessage {
  id        Int        @id @default(autoincrement())
  threadId  Int        @map("thread_id")
  role      String     // 'user' | 'assistant'
  content   String     @db.Text
  createdAt DateTime   @default(now()) @map("created_at")

  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("sphera_chat_messages")
}

model AnnaleSession {
  id      Int        @id @default(autoincrement())
  ownerId Int        @map("owner_id")
  mode    AnnaleMode @default(COMPLETE)

  sourceFilename  String @default("") @map("source_filename")
  resourceId      Int?   @map("resource_id")
  coursResourceId Int?   @map("cours_resource_id")

  content Json @default("{}")

  /// MUST be written at generation time. Django never persisted it, so
  /// /annales/<id>/ask/ could only ever return 400 — annale Q&A was unreachable.
  extractedText String @default("") @map("extracted_text")
  qaHistory     Json   @default("[]") @map("qa_history")

  isShared       Boolean @default(false) @map("is_shared")
  sharedSphereId Int?    @map("shared_sphere_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  resource      Resource? @relation("AnnalePaper", fields: [resourceId], references: [id], onDelete: SetNull)
  coursResource Resource? @relation("AnnaleCours", fields: [coursResourceId], references: [id], onDelete: SetNull)
  sharedSphere  Sphere?   @relation(fields: [sharedSphereId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
  @@index([sharedSphereId, isShared])
  @@map("annale_sessions")
}

// ─────────────────────────────────────────────────────────────
// Uploads
// ─────────────────────────────────────────────────────────────

/// UUID primary key retained: the route is `/api/upload/<uuid:pk>/`.
model UploadedFile {
  id           String     @id @default(uuid())
  fileUrl      String     @map("file_url")
  storageKey   String?    @map("storage_key")
  originalName String     @map("original_name")
  fileType     String     @map("file_type")
  fileSize     Int        @map("file_size")
  uploadType   UploadType @map("upload_type")
  uploadedById Int        @map("uploaded_by_id")
  isProcessed  Boolean    @default(false) @map("is_processed")
  isPublic     Boolean    @default(false) @map("is_public")
  uploadedAt   DateTime   @default(now()) @map("uploaded_at")

  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([uploadedById, uploadedAt])
  @@map("uploaded_files")
}

// ─────────────────────────────────────────────────────────────
// Events & Attendees
// ─────────────────────────────────────────────────────────────

model Event {
  id           Int           @id @default(autoincrement())
  title        String
  description  String        @default("")
  category     EventCategory @default(OTHER)

  organizerId  Int           @map("organizer_id")
  sphereId     Int?          @map("sphere_id")

  startDate    DateTime      @map("start_date")
  endDate      DateTime?     @map("end_date")
  location     String        @default("")
  isOnline     Boolean       @default(false) @map("is_online")
  onlineLink   String?       @map("online_link")

  coverImage   String?       @map("cover_image")
  maxAttendees Int?          @map("max_attendees")
  isPublic     Boolean       @default(true) @map("is_public")
  isFeatured   Boolean       @default(false) @map("is_featured")

  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  organizer    User          @relation("EventsOrganized", fields: [organizerId], references: [id], onDelete: Cascade)
  sphere       Sphere?       @relation("SphereEvents", fields: [sphereId], references: [id], onDelete: SetNull)
  attendees    EventAttendee[]

  @@index([startDate])
  @@index([category])
  @@index([sphereId])
  @@index([organizerId])
  @@map("events")
}

model EventAttendee {
  id            Int                 @id @default(autoincrement())
  eventId       Int                 @map("event_id")
  userId        Int                 @map("user_id")
  status        EventAttendeeStatus @default(INTERESTED)
  ticketCode    String?             @unique @map("ticket_code")
  checkedInAt   DateTime?           @map("checked_in_at")
  checkedInById Int?                @map("checked_in_by_id")
  registeredAt  DateTime            @default(now()) @map("registered_at")

  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User                @relation("UserEventAttendances", fields: [userId], references: [id], onDelete: Cascade)
  checkedInBy   User?               @relation("EventCheckins", fields: [checkedInById], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@index([userId, status])
  @@index([eventId, status])
  @@index([ticketCode])
  @@map("event_attendees")
}


// ─────────────────────────────────────────────────────────────
// Quiz Live (Sphera Live — multiplayer quiz sessions)
// ─────────────────────────────────────────────────────────────

enum QuizLiveStatus {
  WAITING
  ACTIVE
  QUESTION_ACTIVE
  QUESTION_RESULTS
  FINISHED
}

model QuizLiveSession {
  id                   Int             @id @default(autoincrement())
  roomCode             String          @unique @map("room_code")
  hostId               Int             @map("host_id")
  title                String          @default("")
  questions            Json            @default("[]")
  status               QuizLiveStatus  @default(WAITING)
  currentQuestionIndex Int             @default(-1) @map("current_question_index")
  createdAt            DateTime        @default(now()) @map("created_at")

  host                 User            @relation("QuizLiveSessionsHosted", fields: [hostId], references: [id], onDelete: Cascade)
  participants         QuizLiveParticipant[]

  @@index([roomCode])
  @@index([hostId])
  @@map("quiz_live_sessions")
}

model QuizLiveParticipant {
  id          Int      @id @default(autoincrement())
  sessionId   Int      @map("session_id")
  userId      Int?     @map("user_id")
  displayName String   @map("display_name")
  score       Int      @default(0)
  answers     Json     @default("[]")
  joinedAt    DateTime @default(now()) @map("joined_at")

  session     QuizLiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User?           @relation("QuizLiveParticipations", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([sessionId, userId])
  @@index([sessionId, score])
  @@map("quiz_live_participants")
}

// ─────────────────────────────────────────────────────────────
// Sphera Usage & AI Cost Tracking
// ─────────────────────────────────────────────────────────────

model GenerationUsage {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  weekStartDate DateTime @map("week_start_date") @db.Date
  count         Float    @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStartDate])
  @@index([userId, weekStartDate])
  @@map("generation_usages")
}

model AIUsageLog {
  id                   Int      @id @default(autoincrement())
  userId               Int?     @map("user_id")
  provider             String
  model                String   @default("")
  toolType             String   @map("tool_type")
  inputTokensEstimate  Int      @default(0) @map("input_tokens_estimate")
  outputTokensEstimate Int      @default(0) @map("output_tokens_estimate")
  estimatedCostUSD     Float    @default(0) @map("estimated_cost_usd")
  createdAt            DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([provider, createdAt])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

// ─────────────────────────────────────────────────────────────
// Sphera Preferences (Standalone Sphera configuration)
// ─────────────────────────────────────────────────────────────

model SpheraPreferences {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique @map("user_id")
  defaultLanguage   String   @default("auto") @map("default_language") // 'auto', 'fr', 'en'
  detailLevel       String   @default("standard") @map("detail_level") // 'court', 'standard', 'detaille'
  tone              String   @default("decontracte") // 'decontracte', 'formel'
  quizQuestionCount Int?     @map("quiz_question_count") // null = auto (system decides, between 10 and 30)
  quizTimeLimit     Int      @default(15) @map("quiz_time_limit") // seconds per question
  flashcardCount    Int?     @map("flashcard_count") // null = auto (system decides, between 10 and 30)
  theme             String   @default("sombre") // 'system', 'sombre', 'clair'
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sphera_preferences")
}

